{
  "$meta": { "name": "Verba Design Tokens", "theme": "light", "version": "1.1", "a11y": "all text/UI values meet WCAG AA — see brand-color.md" },
  "brand": {
    "50": "#F2EEFF", "100": "#E6E0FF", "200": "#CFC2FF", "300": "#AE97FF", "400": "#8763FF",
    "500": "#5F3EFF", "600": "#4F2BEA", "700": "#3D1FC4", "800": "#2C1690", "900": "#1F0F66",
    "primary": "#5F3EFF",
    "pressed": "#4F2BEA",
    "onPrimary": "#FFFFFF",
    "pale": "#F2EEFF",
    "border": "#DCD2FF"
  },
  "accent": {
    "purple": { "fg": "#5F3EFF", "bg": "#F2EEFF" },
    "teal":   { "fg": "#3FB3A6", "bg": "#DDF2EE" },
    "coral":  { "fg": "#E0795A", "bg": "#FBE7E1" }
  },
  "surface": {
    "page": "#F4F4F6",
    "canvas": "#FFFFFF",
    "surface": "#FFFFFF",
    "surfaceSoft": "#F8F8FA"
  },
  "text": { "ink": "#17171B", "body": "#4B4B57", "mute": "#6E6E7A" },
  "border": { "default": "#E5E5EA", "subtle": "#EDEDF1" },
  "status": { "ok": "#15803D", "warn": "#B45309", "danger": "#DC2626" },
  "radius": { "input": 9, "button": 10, "card": 16, "pill": 9999 },
  "spacing": [4, 8, 12, 16, 20, 24, 28, 32, 40, 48],
  "elevation": { "card": "0 18px 44px -30px rgba(30,27,75,0.08)" },
  "typography": {
    "fontFamily": "Pretendard, -apple-system, BlinkMacSystemFont, Inter, system-ui, 'Apple SD Gothic Neo', sans-serif",
    "scale": {
      "display":    { "size": 44, "weight": 700, "tracking": "-0.03em", "line": 1.06 },
      "h1":         { "size": 27, "weight": 700, "tracking": "-0.025em" },
      "h2":         { "size": 22, "weight": 700 },
      "h3":         { "size": 18, "weight": 700 },
      "title":      { "size": 15, "weight": 600 },
      "body":       { "size": 15, "weight": 400, "line": 1.6 },
      "bodyStrong": { "size": 14, "weight": 600 },
      "caption":    { "size": 12, "weight": 400 },
      "label":      { "size": 12, "weight": 600, "tracking": "1.4px", "transform": "uppercase" },
      "button":     { "size": 15, "weight": 600 }
    },
    "weights": { "body": 400, "medium": 500, "emphasis": 600, "heading": 700 }
  }
}
